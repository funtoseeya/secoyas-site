Options -Indexes
ErrorDocument 404 /404.html

RewriteEngine On

# One address for the whole site: https://secoyaseventos.cl (no www, no "nuevo.")
RewriteCond %{HTTPS} off [OR]
RewriteCond %{HTTP_HOST} ^(www|nuevo)\. [NC]
RewriteRule ^ https://secoyaseventos.cl%{REQUEST_URI} [R=301,L]

# Old WordPress addresses → new pages, so Google and old links keep working
RewriteRule ^index\.php/about/?$ /espacios/ [R=301,L,NC]
RewriteRule ^index\.php/galeria/?$ /galeria/ [R=301,L,NC]
RewriteRule ^index\.php/contact/?$ /cotizar/ [R=301,L,NC]
RewriteRule ^index\.php/testimonios-2/?$ / [R=301,L,NC]
RewriteRule ^index\.php/?$ / [R=301,L,NC]
RewriteRule ^index\.php/ / [R=301,L,NC]
RewriteRule ^wp-content/gallery/ /galeria/ [R=301,L,NC]
RewriteRule ^(feed|comments/feed)/?$ / [R=301,L,NC]
RewriteRule ^(wp-admin|wp-login\.php|xmlrpc\.php|wp-json) - [G,L,NC]

# This site has no PHP. Refuse any PHP file so nothing can run on the server.
<FilesMatch "\.(php\d?|phtml|phar)$">
  <IfModule mod_authz_core.c>
    Require all denied
  </IfModule>
  <IfModule !mod_authz_core.c>
    Order allow,deny
    Deny from all
  </IfModule>
</FilesMatch>

# Security headers
<IfModule mod_headers.c>
  Header always set Strict-Transport-Security "max-age=31536000" "expr=%{HTTPS} == 'on'"
  Header always set X-Content-Type-Options "nosniff"
  Header always set X-Frame-Options "SAMEORIGIN"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
  Header always set Permissions-Policy "geolocation=(), microphone=(), camera=()"
</IfModule>

# Compression
<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/css application/javascript text/plain application/xml image/svg+xml application/ld+json
</IfModule>

# Caching: photos and fonts for a year, CSS/JS for a week, pages always fresh
<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresByType image/webp "access plus 1 year"
  ExpiresByType image/jpeg "access plus 1 year"
  ExpiresByType image/png "access plus 1 year"
  ExpiresByType font/woff2 "access plus 1 year"
  ExpiresByType text/css "access plus 1 week"
  ExpiresByType application/javascript "access plus 1 week"
  ExpiresByType text/html "access plus 0 seconds"
</IfModule>
AddType font/woff2 .woff2
AddType image/webp .webp
